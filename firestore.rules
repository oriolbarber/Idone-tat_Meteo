rules_version = '2';
// CEM · regles de Firestore
// - usuaris/{uid}: perfil (nom, correu, rol). El rol i el premium només els canvia l'administració.
// - admins/{uid}: administració addicional (la inicial és el correu de l'Oriol, confirmat).
// - propostes/{id}: parets proposades. Les crea qui té el correu confirmat i accepta la llicència ODbL.
//   Les revisa (aprova o rebutja) l'administració, un revisor o un premium.
// - parets/{id}: parets publicades (provisionals i confirmades). Lectura pública (l'app la llegeix sense compte).
// - sectors/{id}, roques/{zona}: sectors nous i tipus de roca aportats per la comunitat. Lectura pública.
// - orientacions/{sector_cara}: orientacions de sectors (comunitat). Lectura pública.
// - valoracions/{id}: valoracions de confort compartides (paret o sector, dia, franja, vot). Les llegeix qui les ha fet i la revisió.
// - ombres/{clau}: nivell d'ombra al peu de la paret aprovat a partir de les valoracions. Lectura pública.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed(){ return request.auth != null; }
    function verified(){ return signed() && request.auth.token.email_verified == true; }
    function owner(){ return verified() && request.auth.token.email == "oriolbarber@gmail.com"; }
    function isAdmin(){ return owner() || (signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }
    function prof(){ return get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data; }
    function hasProf(){ return signed() && exists(/databases/$(database)/documents/usuaris/$(request.auth.uid)); }
    function reviewer(){ return isAdmin() || (hasProf() && (prof().rol == "revisor" || prof().get("premium", false) == true)); }
    function str(v, n){ return v is string && v.size() > 0 && v.size() <= n; }

    // ---------- Aportacions de la comunitat (parets, sectors nous, orientacions, roca) ----------
    // Es publiquen a l'instant com a «provisional»; 2 confirmacions d'altres persones = «confirmada»;
    // 2 rebutjos = «revisio» (l'app l'amaga i va a la safata de revisió). Persones marcades amb «revisar» → «pendent».
    // Comptes de menys de 7 dies: màxim 5 aportacions al dia (comptador dia/n del perfil, al mateix batch).
    function today(){ return math.floor(request.time.toMillis() / 86400000); }
    function uref(){ return /databases/$(database)/documents/usuaris/$(request.auth.uid); }
    function nextN(a){ return a.get("dia", 0) == today() ? a.get("n", 0) + 1 : 1; }
    function counted(){
      let a = get(uref()).data;
      let b = getAfter(uref()).data;
      return b.get("dia", -1) == today() && b.get("n", -1) == nextN(a)
        && (nextN(a) <= 5 || request.time > a.get("creat", request.time) + duration.value(7, "d"));
    }
    function est0(){ return reviewer() ? "confirmada" : (prof().get("revisar", false) == true ? "pendent" : "provisional"); }
    // nova aportació (o edició que torna a començar): sense vots, de qui l'envia, llicència ODbL
    function fresh(d){
      return verified() && hasProf() && (reviewer() || counted())
        && d.estat == est0() && d.conf == {} && d.reb == {}
        && d.per == request.auth.uid && d.llicencia == "ODbL-1.0";
    }
    function affC(){ return request.resource.data.diff(resource.data).affectedKeys(); }
    function addMe(m){
      let df = request.resource.data[m].diff(resource.data[m]);
      return df.addedKeys().hasOnly([request.auth.uid]) && df.addedKeys().size() == 1
        && df.removedKeys().size() == 0 && df.changedKeys().size() == 0;
    }
    // ✓ / ✗ d'una altra persona registrada (no qui l'ha enviada, un sol cop)
    function vote(){
      let a = resource.data;
      let d = request.resource.data;
      return verified() && hasProf() && a.get("estat", "") == "provisional"
        && request.auth.uid != a.per && !(request.auth.uid in a.conf) && !(request.auth.uid in a.reb)
        && affC().hasOnly(["conf", "reb", "estat"])
        && ((!affC().hasAny(["reb"]) && addMe("conf") && d.estat == (d.conf.size() >= 2 ? "confirmada" : "provisional"))
         || (!affC().hasAny(["conf"]) && addMe("reb") && d.estat == (d.reb.size() >= 2 ? "revisio" : "provisional")));
    }
    // es pot editar el que és visible (provisional o confirmat), no el que és en revisió o pendent
    function editable(){ return resource.data.get("estat", "confirmada") in ["provisional", "confirmada"]; }
    // «prev» = últim valor confirmat (per poder-lo restaurar si la comunitat rebutja el nou)
    function prevOk(field){
      let a = resource.data;
      return request.resource.data.prev == (a.get("estat", "confirmada") == "confirmada" ? a[field] : a.get("prev", null));
    }
    function okNum(v, lo, hi){ return (v is number) && v >= lo && v < hi; }
    function ownDraft(){ return signed() && resource.data.get("per", "") == request.auth.uid && resource.data.get("estat", "") in ["provisional", "pendent"]; }

    match /usuaris/{uid} {
      allow read: if signed() && (request.auth.uid == uid || reviewer());
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["nom", "email", "rol", "consentVersio", "consentAt", "creat"])
        && request.resource.data.rol == "registrat" && str(request.resource.data.nom, 80)
        && request.resource.data.email == request.auth.token.email;
      // la persona es canvia el nom i marca que ha acceptat la llicència; l'administració, el rol i el premium
      allow update: if signed() && (
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nom", "odblAt", "dia", "n"])
          && str(request.resource.data.nom, 80)
          // el comptador d'aportacions només pot pujar d'un en un (no es pot posar a zero)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["dia", "n"])
            || (request.resource.data.dia == today() && request.resource.data.n == nextN(resource.data))))
        || (isAdmin() && request.auth.uid != uid));
      allow delete: if signed() && (request.auth.uid == uid || isAdmin());
    }

    match /admins/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow write: if owner();
    }

    match /propostes/{id} {
      allow read: if signed() && (resource.data.userId == request.auth.uid || reviewer());
      function okAz(v){ return v is number && v >= 0 && v < 360; }
      allow create: if verified() && hasProf()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.estat == "pendent"
        && request.resource.data.llicencia == "ODbL-1.0"
        && str(request.resource.data.zone, 60) && str(request.resource.data.name, 80)
        && ((request.resource.data.tipus == "paret"
            && request.resource.data.exp in ["exposat", "arrecerat"]
            && str(request.resource.data.d, 200000)
            && request.resource.data.keys().hasOnly(["userId", "tipus", "zone", "name", "exp", "d", "estat", "llicencia", "licAt", "creat"]))
          // orientació d'un sector d'OSM (cara 0–7)
          || (request.resource.data.tipus == "orientacio"
            && str(request.resource.data.sector, 40) && request.resource.data.cara is int
            && request.resource.data.cara >= 0 && request.resource.data.cara < 8
            && okAz(request.resource.data.az) && okAz(request.resource.data.azAuto)
            && request.resource.data.keys().hasOnly(["userId", "tipus", "zone", "name", "sector", "cara", "az", "azAuto", "estat", "llicencia", "licAt", "creat"])));
      allow update: if reviewer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estat", "motiu", "revisatPer", "revisatAt"])
        && request.resource.data.estat in ["aprovada", "rebutjada"];
      // qui l'ha enviada la pot retirar (i en esborrar el compte, totes); l'administració també
      allow delete: if signed() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Restriccions: les afegeix i les ratifica la comunitat (2 confirmacions d'altres persones).
    // Per retirar-ne una: algú ho proposa (retPer) i 2 persones més ho confirmen (ret).
    // L'administració, revisors i premium poden confirmar, retirar o esborrar directament.
    match /restriccions/{id} {
      function okR(d){
        return d.tipus in ["niu", "tanc", "altre"] && str(d.zone, 60) && d.cadaAny is bool
          && str(d.des, 10) && str(d.fins, 10)
          && d.sector is string && d.sector.size() <= 120 && d.desc is string && d.desc.size() <= 300
          && d.font is string && d.font.size() <= 300;
      }
      function aff(){ return request.resource.data.diff(resource.data).affectedKeys(); }
      function addOnlyMe(m){ return request.resource.data[m].diff(resource.data[m]).addedKeys().hasOnly([request.auth.uid])
        && request.resource.data[m].diff(resource.data[m]).removedKeys().size() == 0
        && request.resource.data[m].diff(resource.data[m]).changedKeys().size() == 0; }
      function sameEstat(){ return request.resource.data.estat == resource.data.estat; }
      allow read: if true;
      allow create: if verified() && hasProf() && okR(request.resource.data)
        && request.resource.data.keys().hasOnly(["zone", "tipus", "cadaAny", "des", "fins", "sector", "desc", "font", "estat", "conf", "creatPer", "llicencia", "creat", "act"])
        && request.resource.data.estat == "pendent" && request.resource.data.conf == {}
        && request.resource.data.creatPer == request.auth.uid && request.resource.data.llicencia == "ODbL-1.0";
      allow update: if verified() && hasProf() && (
        // confirmar-la (no qui l'ha creada); amb 2 confirmacions passa a «confirmada»
        (request.auth.uid != resource.data.creatPer && aff().hasOnly(["conf", "estat", "act"]) && addOnlyMe("conf")
          && (sameEstat() || (request.resource.data.estat == "confirmada" && request.resource.data.conf.size() >= 2)))
        // proposar-ne la retirada (si no n'hi ha cap de proposada)
        || (!("retPer" in resource.data) && aff().hasOnly(["retPer", "ret", "act"])
          && request.resource.data.retPer == request.auth.uid && request.resource.data.ret == {})
        // confirmar la retirada (no qui l'ha proposada); amb 2 passa a «retirada»
        || ("retPer" in resource.data && request.auth.uid != resource.data.retPer && aff().hasOnly(["ret", "estat", "act"]) && addOnlyMe("ret")
          && (sameEstat() || (request.resource.data.estat == "retirada" && request.resource.data.ret.size() >= 2)))
        // qui ha proposat la retirada la pot desfer
        || ("retPer" in resource.data && request.auth.uid == resource.data.retPer && aff().hasOnly(["retPer", "ret", "act"])
          && !("retPer" in request.resource.data))
        // administració, revisors i premium
        || (reviewer() && aff().hasOnly(["estat", "retPer", "ret", "act"]) && request.resource.data.estat in ["pendent", "confirmada", "retirada"])
      );
      allow delete: if reviewer() || (signed() && resource.data.creatPer == request.auth.uid && resource.data.estat == "pendent");
    }

    // Orientació d'una cara de sector (d'OSM o de la comunitat): {sector}_{cara}. Lectura pública; mana sobre OSM i el relleu.
    match /orientacions/{id} {
      function okO(d){
        return d.keys().hasOnly(["sector", "cara", "zone", "az", "prev", "estat", "conf", "reb", "per", "llicencia", "act", "v", "aprovat"])
          && str(d.sector, 40) && d.cara is int && d.cara >= 0 && d.cara < 8 && id == d.sector + "_" + string(d.cara)
          && str(d.zone, 60) && okNum(d.az, 0, 360) && (d.get("prev", null) == null || okNum(d.get("prev", 0), 0, 360));
      }
      allow read: if true;
      allow create: if okO(request.resource.data) && fresh(request.resource.data) && request.resource.data.prev == null;
      allow update: if (okO(request.resource.data) && editable() && fresh(request.resource.data) && prevOk("az"))
        || vote()
        || (reviewer() && okO(request.resource.data));
      allow delete: if reviewer();
    }

    // Sectors nous que no són a OpenStreetMap (punt al mapa, nom i cap on mira). Lectura pública.
    match /sectors/{id} {
      function okS(d){
        return d.keys().hasOnly(["zone", "name", "lat", "lon", "kind", "az", "estat", "conf", "reb", "per", "llicencia", "act"])
          && str(d.zone, 60) && d.name is string && d.name.size() <= 80
          && okNum(d.lat, -90, 90) && okNum(d.lon, -180, 180) && d.kind in ["sector", "bloc"]
          && (d.get("az", null) == null || okNum(d.get("az", 0), 0, 360));
      }
      allow read: if true;
      allow create: if okS(request.resource.data) && fresh(request.resource.data);
      allow update: if vote() || (reviewer() && okS(request.resource.data));
      allow delete: if reviewer() || ownDraft();
    }

    // Tipus de roca d'una zona (canvia el temps de secat): {zona}. Lectura pública.
    match /roques/{id} {
      function okK(d){
        return d.keys().hasOnly(["zone", "rock", "prev", "estat", "conf", "reb", "per", "llicencia", "act"])
          && d.zone == id && d.rock in ["calcaria", "granit", "conglomerat", "gres"]
          && (d.get("prev", null) == null || d.get("prev", "") in ["calcaria", "granit", "conglomerat", "gres"]);
      }
      allow read: if true;
      allow create: if okK(request.resource.data) && fresh(request.resource.data) && request.resource.data.prev == null;
      allow update: if (okK(request.resource.data) && editable() && fresh(request.resource.data) && prevOk("rock"))
        || vote()
        || (reviewer() && okK(request.resource.data));
      allow delete: if reviewer();
    }

    // Valoracions de confort: les crea qui té el correu confirmat; només per ajustar l'ombra de les parets
    match /valoracions/{id} {
      allow read: if reviewer() || (signed() && resource.data.userId == request.auth.uid);
      allow create: if verified() && hasProf()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["userId", "zone", "key", "dia", "franja", "rol", "vot", "dif", "sol", "nivell", "creat"])
        && str(request.resource.data.zone, 60) && str(request.resource.data.key, 80) && str(request.resource.data.dia, 10)
        && request.resource.data.franja in ["am", "pm"] && request.resource.data.rol in ["climb", "belay"]
        && request.resource.data.vot is int && request.resource.data.vot >= -3 && request.resource.data.vot <= 3
        && request.resource.data.dif is number && request.resource.data.dif >= -6 && request.resource.data.dif <= 6
        && request.resource.data.sol is number && request.resource.data.sol >= 0 && request.resource.data.sol <= 1
        && request.resource.data.nivell is int && request.resource.data.nivell >= 0 && request.resource.data.nivell <= 3;
      allow delete: if signed() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Nivell d'ombra revisat: {clau amb «_»}. Lectura pública; mana sobre el de la paret proposada.
    match /ombres/{id} {
      allow read: if true;
      allow create, update: if reviewer()
        && request.resource.data.keys().hasOnly(["key", "zone", "nivell", "n", "v", "aprovat"])
        && str(request.resource.data.key, 80)
        && request.resource.data.nivell is int && request.resource.data.nivell >= 0 && request.resource.data.nivell <= 3;
      allow delete: if isAdmin();
    }

    // Parets traçades: es publiquen a l'instant (provisional) i les valida la comunitat. Lectura pública.
    // Les antigues (aprovades per la revisió, sense «estat») compten com a confirmades.
    match /parets/{id} {
      function okP(d){
        return d.keys().hasOnly(["zone", "name", "exp", "d", "llicencia", "v", "aprovat", "estat", "conf", "reb", "per", "act"])
          && str(d.zone, 60) && str(d.name, 80) && d.exp in ["exposat", "arrecerat"] && str(d.d, 200000)
          && d.llicencia == "ODbL-1.0";
      }
      allow read: if true;
      allow create: if okP(request.resource.data) && (reviewer() || fresh(request.resource.data));
      allow update: if vote() || (reviewer() && okP(request.resource.data));
      allow delete: if reviewer() || ownDraft();
    }
  }
}
